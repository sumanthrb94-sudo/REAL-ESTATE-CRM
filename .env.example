# ─── EstateCRM environment ───────────────────────────────────────────────
# Copy to .env.local and fill in once you wire up the database & integrations.

# Application
NEXT_PUBLIC_APP_NAME="EstateCRM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Data layer
#   memory  -> in-memory seeded store (default; no DB required)
#   prisma  -> Postgres via Prisma (set DATABASE_URL below)
DATA_DRIVER="memory"

# Database (used when DATA_DRIVER="prisma")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/estate_crm?schema=public"

# Auth / sessions
AUTH_SECRET="change-me-in-production"
SESSION_COOKIE="estatecrm_session"

# Integrations (optional — wire up later)
# Telephony / IVR
TELEPHONY_PROVIDER=""
TELEPHONY_API_KEY=""
# Messaging
WHATSAPP_API_KEY=""
SMS_API_KEY=""
SENDGRID_API_KEY=""
# Lead source webhooks
FACEBOOK_LEAD_VERIFY_TOKEN=""
GOOGLE_ADS_WEBHOOK_SECRET=""
