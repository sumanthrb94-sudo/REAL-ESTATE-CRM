# ─── EstateCRM environment ───────────────────────────────────────────────
# Copy to .env.local and fill in once you wire up the database & integrations.

# Application
NEXT_PUBLIC_APP_NAME="EstateCRM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Data layer
#   memory   -> in-memory seeded store (default; no DB required; not durable on serverless)
#   firebase -> Firestore via the Firebase Admin SDK (set FIREBASE_* below)
#   prisma   -> Postgres via Prisma (set DATABASE_URL below)
DATA_DRIVER="memory"

# Firebase / Firestore (used when DATA_DRIVER="firebase")
# From Firebase Console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Paste the full key on one line, keeping the literal \n escapes (the app and
# Vercel both handle them; the code converts \n back into real newlines).
FIREBASE_PRIVATE_KEY=""

# Database (used when DATA_DRIVER="prisma")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/estate_crm?schema=public"

# Auth / sessions
AUTH_SECRET="change-me-in-production"
SESSION_COOKIE="estatecrm_session"

# Integrations (optional — wire up later)
# Telephony / IVR
TELEPHONY_PROVIDER=""
TELEPHONY_API_KEY=""
# Messaging
WHATSAPP_API_KEY=""
SMS_API_KEY=""
SENDGRID_API_KEY=""
# Lead source webhooks
FACEBOOK_LEAD_VERIFY_TOKEN=""
GOOGLE_ADS_WEBHOOK_SECRET=""
