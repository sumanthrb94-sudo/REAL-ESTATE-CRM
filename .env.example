# ─── EstateCRM environment ───────────────────────────────────────────────
# Copy to .env.local and fill in.

# Application
NEXT_PUBLIC_APP_NAME="EstateCRM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Sessions (required) ─────────────────────────────────────────────────
# Signs the session cookie. MUST be set to at least 32 characters in
# production — the app refuses to boot otherwise, because a predictable
# secret means anyone can forge a session for any user.
#   openssl rand -base64 48
SESSION_SECRET=""
SESSION_COOKIE="estatecrm_session"

# ─── Data layer ──────────────────────────────────────────────────────────
#   memory   -> in-memory store, rebuilt on every boot. Fine for local UI work.
#               NOT durable: every write is lost on restart, and on serverless
#               each instance holds its own copy.
#   firebase -> Firestore via the Firebase Admin SDK. Durable. Set FIREBASE_* below.
DATA_DRIVER="memory"

# Firebase / Firestore (required when DATA_DRIVER="firebase")
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Paste the full key on one line, keeping the literal \n escapes (the app and
# Vercel both handle them; the code converts \n back into real newlines).
FIREBASE_PRIVATE_KEY=""

# ─── Bootstrap admin ─────────────────────────────────────────────────────
# The single account created by the seed. It is flagged "must change
# password", so this value only ever gets you to the change-password screen.
BOOTSTRAP_EMAIL="admin@estatecrm.local"
BOOTSTRAP_PASSWORD="changeme-on-first-login"

# ─── Messaging ───────────────────────────────────────────────────────────
#   log     -> (default) records what would be sent and delivers nothing.
#              Safe everywhere; nothing can reach a real buyer by accident.
#   resend  -> real email. Requires RESEND_API_KEY and EMAIL_FROM below.
MESSAGING_DRIVER="log"

# Resend -> API Keys. Verify a SUBDOMAIN you control (crm.example.com), not the
# domain your staff read mail on: a campaign marked as spam damages the sending
# domain's reputation, and that must not reach day-to-day email.
RESEND_API_KEY=""
# Fallback sender when a message names none. Per-agent senders are composed at
# send time so a buyer's reply reaches the person who owns the lead.
EMAIL_FROM="EstateCRM <noreply@crm.example.com>"

# ─── Not yet wired ───────────────────────────────────────────────────────
# WhatsApp needs a verified Meta Business account, a dedicated number and
# templates approved by Meta before any of these do anything. Indian SMS needs
# TRAI DLT registration first, or carriers drop the message silently.
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# WHATSAPP_APP_SECRET=""
# SMS_API_KEY=""
# SMS_DLT_ENTITY_ID=""
# SMS_SENDER_ID=""
# SMS_API_KEY=""
# SENDGRID_API_KEY=""

# --- Marketing content engine (Studio) ---
# Market every brief is built for: IN (default), AE, GB, US, SG, AU. Sets currency, regulator label, area unit.
CONTENT_MARKET=IN
# Narration for Reels. "log" returns the script only; "elevenlabs" synthesises it.
VOICE_DRIVER=log
ELEVENLABS_API_KEY=
# One voice id for every project so the brand sounds like one narrator in every language.
# Default is George (premade, any tier). Library voices such as Matt 0aXOy31Cjamp6gJcyqYu need Creator tier.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Operator: language model for copy and narration (OpenAI-compatible) ---
# nvidia (free key at build.nvidia.com), openrouter (":free" models), groq, ollama (local, no key), custom
AI_PROVIDER=
AI_API_KEY=
# Optional overrides; presets exist per provider.
AI_BASE_URL=
AI_MODEL=
# Images: FLUX / SD3.5 on NVIDIA NIM's free developer tier.
NVIDIA_API_KEY=
MEDIA_IMAGE_MODEL=flux.1-schnell
# Monthly generation caps counted by the app's ledger (providers publish no balance).
MEDIA_MONTHLY_IMAGE_CAP=200
MEDIA_MONTHLY_COPY_CAP=1000

# --- Daily lead distribution ---
# Shared secret for the scheduled morning sweep at /api/cron/distribute.
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`. Unset means
# the endpoint refuses to run at all, so a half-configured deploy fails closed.
CRON_SECRET=
